# Base URL API platform-service (tanpa trailing slash).
NUXT_PUBLIC_API_BASE=http://localhost:8080

# Kode solution yang dipakai sebagai audience (aud) sesi login console.
NUXT_PUBLIC_DEFAULT_SOLUTION=platform-console

# Aktifkan polling file watcher (untuk bind-mount di Docker Desktop).
# NUXT_WATCH_POLLING=true
