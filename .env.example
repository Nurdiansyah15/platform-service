# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development          # development | production
APP_PORT=8080
LOG_FORMAT=                  # json | text (kosong: json di production, text lainnya)
LOCALES_DIR=locales
APP_SHUTDOWN_TIMEOUT=15s
DEPLOYMENT_MODE=cloud        # cloud | on_prem (spec §2.14)
ISSUER_URL=http://localhost:8080
CORS_ALLOW_ORIGINS=*         # dipisah koma, mis. https://admin.example.com

# ── Database (PostgreSQL 15+) ────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5442                 # port host dari docker-compose.dev.yml
DB_USER=platform
DB_PASS=secret
DB_NAME=platform
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

# ── Token ────────────────────────────────────────────────────────────────────
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
KEYSTORE_DIR=data/keys     # private key JWT (FileKeyStore); jangan di-commit

# ── Webhook ──────────────────────────────────────────────────────────────────
# Kunci AES-256 base64 (32 byte), mis. `openssl rand -base64 32`. Wajib di production.
WEBHOOK_SECRET_KEY=
WEBHOOK_POLL_INTERVAL=2s
WEBHOOK_TIMEOUT=10s
WEBHOOK_BATCH_SIZE=50

# ── Seeder (make seed) ───────────────────────────────────────────────────────
PLATFORM_ADMIN_EMAIL=admin@platform.local
PLATFORM_ADMIN_NAME=Platform Admin
PLATFORM_ADMIN_PASSWORD=ChangeMe123!

# Solution "console" sebagai audience login platform admin di UI (lihat web/).
# Dipakai juga API: hanya sesi console yang boleh menerbitkan kode SSO (POST /auth/authorize).
CONSOLE_SOLUTION_CODE=platform-console
CONSOLE_SOLUTION_NAME=Platform Console

# ── Web UI (Nuxt, web/) ──────────────────────────────────────────────────────
# Diteruskan ke container `web` lewat docker-compose.dev.yml.
WEB_PORT=3331                # port host UI Nuxt
NUXT_PUBLIC_API_BASE=http://localhost:8080   # base URL API (tanpa trailing slash)
NUXT_PUBLIC_DEFAULT_SOLUTION=platform-console # audience (aud) sesi login console
NUXT_WATCH_POLLING=false     # true untuk bind-mount di Docker Desktop
