# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development          # development | production
APP_PORT=8080
LOG_FORMAT=                  # json | text (kosong: json di production, text lainnya)
LOCALES_DIR=locales
APP_SHUTDOWN_TIMEOUT=15s
DEPLOYMENT_MODE=cloud        # cloud | on_prem (spec §2.14)
ISSUER_URL=http://localhost:8080
CORS_ALLOW_ORIGINS=*         # dipisah koma, mis. https://admin.example.com

# ── Database (PostgreSQL 15+) ────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5442                 # port host dari docker-compose.dev.yml
DB_USER=platform
DB_PASS=secret
DB_NAME=platform
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

# ── Token ────────────────────────────────────────────────────────────────────
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
KEYSTORE_DIR=data/keys     # private key JWT (FileKeyStore); jangan di-commit

# ── Seeder (make seed) ───────────────────────────────────────────────────────
PLATFORM_ADMIN_EMAIL=admin@platform.local
PLATFORM_ADMIN_NAME=Platform Admin
PLATFORM_ADMIN_PASSWORD=ChangeMe123!
