        "/api/v1/oauth/token": {
            "post": {
                "description": "RFC 6749 §4.4. Kredensial via HTTP Basic atau field body. Respons \u0026 error format OAuth2 standar (tanpa envelope).",
                "consumes": [
                    "application/x-www-form-urlencoded"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Service Auth"
                ],
                "summary": "OAuth2 token (client credentials)",
                "parameters": [
                    {
                        "type": "string",
                        "description": "client_credentials",
                        "name": "grant_type",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Client ID (bila tidak memakai Basic)",
                        "name": "client_id",
                        "in": "formData"
                    },
                    {
                        "type": "string",
                        "description": "Client secret (bila tidak memakai Basic)",
                        "name": "client_secret",
                        "in": "formData"
                    },
                    {
                        "type": "string",
                        "description": "Subset scope, dipisah spasi",
                        "name": "scope",
                        "in": "formData"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/dto.OAuthTokenResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/dto.OAuthError"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/dto.OAuthError"
                        }
                    }
                }
            }
        },
