                "email",
                "password",
                "solution"
            ],
            "properties": {
                "email": {
                    "type": "string",
                    "maxLength": 255
                },
                "password": {
                    "type": "string",
                    "maxLength": 72
                },
                "solution": {
                    "description": "Solution adalah solutions.code tujuan login (menjadi aud token).",
